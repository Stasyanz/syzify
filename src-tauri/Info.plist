<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by Tauri into the app's own Info.plist (and embedded in the
     binary of `tauri dev`). WKWebView reports in
     navigator.languages the system languages the app is localized for;
     without this list a Russian or Italian Mac reads "en-US" and the
     System language setting never leaves English (#231).
     NSBluetoothAlwaysUsageDescription: macOS kills a process that touches
     Bluetooth without it; indoor training talks to the trainer, power
     pedals and heart rate strap over BLE (#271). -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>ru</string>
    <string>it</string>
  </array>
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>Syzify connects to your smart trainer, power pedals and heart rate strap over Bluetooth for indoor workouts.</string>
</dict>
</plist>
