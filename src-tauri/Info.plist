<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by Tauri into the app's own Info.plist. WKWebView reports in
     navigator.languages the system languages the app is localized for;
     without this list a Russian or Italian Mac reads "en-US" and the
     System language setting never leaves English (#231). -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>ru</string>
    <string>it</string>
  </array>
</dict>
</plist>
