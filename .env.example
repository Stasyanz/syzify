# Overrides for the defaults baked into src/lib/contact.ts.
# Leave empty to use the built-in fallbacks (Syzify's own contact address / issues page).

# Public feedback address shown in Settings.
VITE_CONTACT_EMAIL=

# Bug/feature tracker link (must be an https:// GitHub issues URL; anything else is ignored).
VITE_GITHUB_URL=

# The ANT+ network key for local builds (16 hex digits from Garmin's page; see
# README, "ANT+"). Read by src-tauri/build.rs; never commit .env.
# SYZIFY_ANT_KEY=
