# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build output
dist
dist-ssr
*.local

# Rust / Tauri
src-tauri/target/
src-tauri/gen/
examples/**/target/
# Built plugin artifacts: binaries embed third-party crates (extism-pdk,
# serde_json) whose licenses aren't attributed per-binary — build locally
# per examples/plugins/README.md instead of committing them.
examples/**/plugin.wasm
examples/**/*.syzify-ext
tools/**/target/

# Plugin signing keys — never commit
signing-key.hex
*.signing-key.hex

# Test data / temp files
tmp/

# Coverage reports
coverage/
lcov.info

# Python venv
.venv/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code
.claude/

# Local docs (not tracked) — except the dev guidelines, which
# CONTRIBUTING.md references. The public Plugin API documentation
# (Interface Material) lives in examples/plugins/README.md.
docs/*
!docs/development-guidelines.md

# Internal working files (kept local, not published)
PRD.md
scripts/find_race_day_activities.py
scripts/fix_race_durations.py
